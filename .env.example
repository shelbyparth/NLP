# Copy to .env or export variables in your shell. Never commit real secrets.
VERIFACT_DATA_DIR=./data
VERIFACT_MAX_INPUT_CHARS=30000
VERIFACT_MAX_URL_BYTES=2000000
VERIFACT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional dense semantic retrieval. Requires backend/requirements-ml.txt and model access/cache.
VERIFACT_USE_SEMANTIC=0
VERIFACT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional Natural Language Inference model. If unset, stance is UNKNOWN and verdict remains insufficient.
# To enable stance analysis, install the optional ML packages and uncomment the model below.
# The first use downloads model weights from Hugging Face and needs additional disk space and RAM.
# VERIFACT_NLI_MODEL=cross-encoder/nli-distilroberta-base
# Larger alternative: cross-encoder/nli-deberta-v3-base
# Leave the setting unset to keep NLI disabled.

# Optional trained sentiment model (requires requirements-ml.txt; model downloads on first use).
# VERIFACT_SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest

# Optional OpenAI-compatible chat-completions endpoint. These settings are server-side only.
VERIFACT_LLM_BASE_URL=
VERIFACT_LLM_API_KEY=
VERIFACT_LLM_MODEL=

# Optional live news search (Tavily). Leave empty to disable the live-news feed.
TAVILY_API_KEY=
# Optional override; normally keep the official Tavily search endpoint.
# TAVILY_API_URL=https://api.tavily.com/search

# Optional OpenAI-compatible provider. Groq works with its API base URL and a supported model ID.
# VERIFACT_LLM_BASE_URL=https://api.groq.com/openai/v1
# VERIFACT_LLM_API_KEY=your-provider-key
# VERIFACT_LLM_MODEL=your-supported-chat-model
# Optional Windows example when Tesseract is not on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
